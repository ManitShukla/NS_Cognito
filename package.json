{
  "name": "ns-cognito",
  "version": "1.0.0",
  "description": "NS Cognito — Academic Coprocessor & High-Density Telemetry Engine for NSUT",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:client": "vite build --outDir dist/client",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "vercel-build": "npm run build",
    "client": "vite",
    "preview": "vite preview",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:handshake": "tsx scripts/test_auth_handshake.ts",
    "test:academic": "tsx scripts/test_academic_engine.ts",
    "test:timetable": "tsx scripts/test_timetable_engine.ts"
  },
  "keywords": [
    "nsut",
    "plumware",
    "attendance",
    "timetable",
    "telemetry",
    "swiss-editorial"
  ],
  "author": "NS Cognito Core Engineering Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tough-cookie": "^6.0.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/tough-cookie": "^4.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
