# NS Cognito Environment Configuration
NODE_ENV=development
PORT=4000

# Plumware ERP Portal Config
PLUMWARE_BASE_URL=https://www.imsnsit.org/imsnsit
PLUMWARE_TIMEOUT_MS=15000
PLUMWARE_MAX_RETRIES=3

# Transient Session Engine
SESSION_TTL_SECONDS=180
SESSION_STORE_TYPE=memory
REDIS_URL=redis://localhost:6379

# Logging and Telemetry
LOG_LEVEL=info
