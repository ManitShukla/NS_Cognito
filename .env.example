# NS Cognito Environment Configuration
NODE_ENV=production
PORT=3000

# Plumware ERP Portal Config
PLUMWARE_BASE_URL=https://www.imsnsit.org/imsnsit
PLUMWARE_TIMEOUT_MS=8500
PLUMWARE_MAX_RETRIES=1

# Transient Session Engine (Cloud Redis for Vercel Serverless / Ephemeral In-Memory for Local Dev)
SESSION_TTL_SECONDS=180
SESSION_STORE_TYPE=redis
# Upstash Redis / Redis Cloud / AWS ElastiCache TLS connection string:
REDIS_URL=rediss://default:your_upstash_token@your-redis-instance.upstash.io:6379
REDIS_TLS_REJECT_UNAUTHORIZED=true

# CORS and Production Target Domain
APP_URL=https://nscognito.vercel.app
CORS_ORIGIN=https://nscognito.vercel.app

# Logging and Telemetry
LOG_LEVEL=info
